<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trending 历史归档</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap');

        :root {
            --bg: #f6f7fb;
            --ink: #1d2433;
            --muted: #5e6572;
            --line: #d8dce7;
            --card: #ffffff;
            --accent: #1976d2;
            --accent-2: #0a5ea8;
            --ok: #128a5e;
            --radius: 16px;
            --shadow: 0 14px 30px rgba(24, 37, 62, 0.09);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Noto Sans SC", sans-serif;
            color: var(--ink);
            background:
                radial-gradient(1000px 450px at 100% -20%, rgba(25, 118, 210, 0.16), transparent 65%),
                radial-gradient(800px 380px at -10% -20%, rgba(18, 138, 94, 0.14), transparent 65%),
                var(--bg);
        }

        .page {
            max-width: 1080px;
            margin: 0 auto;
            padding: 24px 16px 48px;
        }

        .hero {
            background: linear-gradient(140deg, #f9fcff, #f6fffb);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 24px;
            box-shadow: var(--shadow);
        }

        .title {
            margin: 0;
            font-family: "Manrope", sans-serif;
            font-size: clamp(30px, 5vw, 48px);
            letter-spacing: -0.03em;
            line-height: 1.02;
        }

        .desc {
            margin: 12px 0 0;
            color: var(--muted);
            font-size: 15px;
        }

        .stats {
            margin-top: 14px;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
        }

        .stat {
            border-radius: 12px;
            border: 1px solid var(--line);
            background: #fff;
            padding: 10px;
        }

        .k {
            color: var(--muted);
            font-size: 12px;
            margin-bottom: 4px;
        }

        .v {
            font-weight: 700;
            font-size: 14px;
            word-break: break-word;
        }

        .topbar {
            margin-top: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .go-home {
            text-decoration: none;
            color: #fff;
            background: linear-gradient(120deg, var(--accent), var(--accent-2));
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(25, 118, 210, 0.26);
        }

        .stamp {
            font-size: 12px;
            color: var(--muted);
        }

        .months {
            margin-top: 16px;
            display: grid;
            gap: 12px;
        }

        .month {
            border: 1px solid var(--line);
            border-radius: 14px;
            background: var(--card);
            overflow: hidden;
            box-shadow: var(--shadow);
            opacity: 0;
            transform: translateY(8px);
            animation: reveal 0.42s ease forwards;
        }

        .month-head {
            width: 100%;
            border: 0;
            background: linear-gradient(130deg, #fbfdff, #f9fbff);
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            text-align: left;
        }

        .month-name {
            font-family: "Manrope", sans-serif;
            font-size: 20px;
            margin: 0;
        }

        .month-count {
            font-size: 12px;
            border-radius: 999px;
            padding: 4px 10px;
            border: 1px solid #c8d8eb;
            color: #255b86;
            background: #edf6ff;
        }

        .month-body {
            display: none;
            border-top: 1px solid var(--line);
        }

        .month.open .month-body {
            display: block;
        }

        .entry {
            display: grid;
            grid-template-columns: 1.5fr 1fr auto;
            gap: 12px;
            align-items: center;
            text-decoration: none;
            color: inherit;
            padding: 12px 16px;
            border-bottom: 1px dashed #e8eaf0;
            transition: background 0.16s ease;
        }

        .entry:hover {
            background: #f8fbff;
        }

        .entry:last-child {
            border-bottom: 0;
        }

        .entry-name {
            font-weight: 700;
            word-break: break-word;
        }

        .entry-date {
            color: var(--muted);
            font-size: 13px;
        }

        .entry-size {
            font-size: 12px;
            color: #445f79;
            border: 1px solid #c9d8e8;
            border-radius: 999px;
            padding: 3px 8px;
            justify-self: end;
        }

        .entry.latest {
            background: linear-gradient(90deg, rgba(18, 138, 94, 0.1), rgba(18, 138, 94, 0.02));
        }

        .entry.latest .entry-name::after {
            content: "最新";
            margin-left: 8px;
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 999px;
            background: #128a5e;
            color: #fff;
            vertical-align: middle;
        }

        @keyframes reveal {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 880px) {
            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 640px) {
            .entry {
                grid-template-columns: 1fr;
                gap: 6px;
            }

            .entry-size {
                justify-self: start;
            }

            .stats {
                grid-template-columns: 1fr;
            }
        }

        .site-signature {
            margin-top: 20px;
            text-align: center;
            color: #5f6875;
            font-size: 13px;
        }

        .site-signature a {
            color: #1c5f9c;
            text-decoration: none;
            border-bottom: 1px solid rgba(28, 95, 156, 0.35);
            padding-bottom: 1px;
        }

        .site-signature a:hover {
            color: #0a5ea8;
            border-bottom-color: rgba(10, 94, 168, 0.55);
        }
    </style>
</head>
<body>
<main class="page">
    <section class="hero">
        <h1 class="title">Trending 历史归档</h1>
        <p class="desc">按月查看历史抓取结果，点击文件可直接打开对应日期页面。</p>
        <div class="stats">
            <div class="stat">
                <div class="k">文件总数</div>
                <div class="v">{{.TotalFiles}}</div>
            </div>
            <div class="stat">
                <div class="k">起始日期</div>
                <div class="v">{{.StartDate}}</div>
            </div>
            <div class="stat">
                <div class="k">最近日期</div>
                <div class="v">{{.EndDate}}</div>
            </div>
            <div class="stat">
                <div class="k">最新记录</div>
                <div class="v">{{.LatestDate}}</div>
            </div>
        </div>
        <div class="topbar">
            <a class="go-home" href="../index.html">返回主页</a>
            <span class="stamp">生成时间：{{.GeneratedAt}}</span>
        </div>
    </section>

    <section class="months">
        {{range .Months}}
        <article class="month {{if .IsExpanded}}open{{end}}">
            <button class="month-head" type="button">
                <h2 class="month-name">{{.DisplayName}}</h2>
                <span class="month-count">{{len .Files}} 条</span>
            </button>
            <div class="month-body">
                {{range .Files}}
                <a class="entry {{if .IsLatest}}latest{{end}}" href="{{.Name}}" target="_blank" rel="noopener">
                    <span class="entry-name">{{.Name}}</span>
                    <span class="entry-date">{{.DateDisplay}}</span>
                    <span class="entry-size">{{.SizeDisplay}}</span>
                </a>
                {{end}}
            </div>
        </article>
        {{end}}
    </section>

    <footer class="site-signature">
        by <a href="https://github.com/vcvvvc/github_trending" target="_blank" rel="noopener">github.com/vcvvvc/github_trending</a>
    </footer>
</main>

<script>
    document.querySelectorAll(".month-head").forEach(head => {
        head.addEventListener("click", () => {
            const month = head.closest(".month");
            month.classList.toggle("open");
        });
    });
</script>
</body>
</html>
