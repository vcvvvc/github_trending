<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Trending Daily</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=Space+Grotesk:wght@500;700&display=swap');

        :root {
            --bg: #f3efe7;
            --ink: #1f2522;
            --panel: #fffaf2;
            --line: #e0d4c2;
            --signal: #0a8f6a;
            --signal-2: #fa7e1e;
            --muted: #6d726d;
            --shadow: 0 16px 40px rgba(38, 27, 11, 0.12);
            --radius: 20px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Noto Sans SC", sans-serif;
            background:
                radial-gradient(1200px 500px at 5% -10%, rgba(10, 143, 106, 0.18), transparent 60%),
                radial-gradient(1200px 500px at 95% -15%, rgba(250, 126, 30, 0.17), transparent 65%),
                var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .shell {
            max-width: 1180px;
            margin: 0 auto;
            padding: 28px 18px 56px;
        }

        .hero {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 26px;
            background: linear-gradient(145deg, #fff7eb, #f6fffb);
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

        .hero::after {
            content: "";
            position: absolute;
            right: -90px;
            top: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(10, 143, 106, 0.2), rgba(10, 143, 106, 0));
            pointer-events: none;
        }

        .title {
            margin: 0;
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(32px, 6vw, 56px);
            line-height: 1.05;
            letter-spacing: -0.03em;
        }

        .subtitle {
            margin: 14px 0 0;
            color: var(--muted);
            font-size: 16px;
        }

        .meta {
            margin-top: 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pill {
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 7px 14px;
            background: #fff;
            font-size: 13px;
            color: #303735;
        }

        .quick {
            margin-top: 16px;
            display: inline-flex;
            gap: 8px;
            align-items: center;
            color: #fff;
            background: linear-gradient(120deg, #0a8f6a, #1aa780);
            text-decoration: none;
            border-radius: 14px;
            padding: 10px 14px;
            font-weight: 700;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 8px 20px rgba(10, 143, 106, 0.26);
        }

        .quick:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(10, 143, 106, 0.32);
        }

        .section-title {
            margin: 28px 0 12px;
            font-family: "Space Grotesk", sans-serif;
            font-size: 20px;
            letter-spacing: -0.02em;
        }

        .language-bar {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .language-btn {
            border: 1px solid #d6cab8;
            background: #fff;
            border-radius: 12px;
            padding: 10px 14px;
            white-space: nowrap;
            font-size: 14px;
            color: #3b403d;
            cursor: pointer;
            transition: all 0.18s ease;
        }

        .language-btn:hover {
            border-color: #b6a89a;
            transform: translateY(-1px);
        }

        .language-btn.active {
            background: linear-gradient(120deg, #fa7e1e, #ef6b00);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 8px 18px rgba(250, 126, 30, 0.3);
        }

        .cards {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 12px;
        }

        .repo-card {
            grid-column: span 6;
            border: 1px solid var(--line);
            background: var(--panel);
            border-radius: 14px;
            padding: 14px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 6px 14px rgba(40, 28, 14, 0.08);
            opacity: 0;
            transform: translateY(10px);
            animation: rise 0.42s ease forwards;
            transition: transform 0.16s ease, box-shadow 0.16s ease;
        }

        .repo-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 22px rgba(20, 16, 10, 0.16);
        }

        .repo-head {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start;
        }

        .repo-name {
            margin: 0;
            font-family: "Space Grotesk", sans-serif;
            font-size: 18px;
            color: #0f4436;
            letter-spacing: -0.01em;
            word-break: break-word;
        }

        .repo-stars {
            border-radius: 999px;
            border: 1px solid #ffcc9f;
            background: #fff3e5;
            font-size: 12px;
            color: #8f4c08;
            padding: 4px 8px;
            flex-shrink: 0;
        }

        .repo-desc {
            margin: 10px 0 0;
            color: #4a4f4c;
            font-size: 14px;
            line-height: 1.45;
        }

        .repo-foot {
            margin-top: 10px;
            font-size: 12px;
            color: #6a6f6c;
        }

        .empty {
            border: 1px dashed #ccb79e;
            border-radius: 14px;
            padding: 26px;
            text-align: center;
            color: #6f6f6f;
            background: rgba(255, 255, 255, 0.7);
        }

        @keyframes rise {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 900px) {
            .repo-card {
                grid-column: span 12;
            }

            .title {
                font-size: clamp(28px, 7vw, 42px);
            }
        }

        .site-signature {
            margin-top: 26px;
            text-align: center;
            color: #5f655f;
            font-size: 13px;
        }

        .site-signature a {
            color: #0f5d4a;
            text-decoration: none;
            border-bottom: 1px solid rgba(15, 93, 74, 0.35);
            padding-bottom: 1px;
        }

        .site-signature a:hover {
            color: #0a8f6a;
            border-bottom-color: rgba(10, 143, 106, 0.55);
        }
    </style>
</head>
<body>
<main class="shell">
    <section class="hero">
        <h1 class="title">GitHub Trending<br>Daily Feed</h1>
        <p class="subtitle">每日抓取热门仓库，按语言快速浏览并可跳转历史记录。</p>
        <div class="meta">
            <span class="pill">日期：{{.Today}}</span>
            <span class="pill">语言分组：{{.GroupCount}}</span>
            <span class="pill">仓库总数：{{.RepoCount}}</span>
        </div>
        <a class="quick" href="daily_trending/index.html">查看历史归档</a>
    </section>

    <h2 class="section-title">语言切换</h2>
    <div class="language-bar" id="language-bar"></div>

    <h2 class="section-title">今日仓库</h2>
    <div class="cards" id="repo-cards"></div>

    <footer class="site-signature">
        by <a href="https://github.com/vcvvvc/github_trending" target="_blank" rel="noopener">github.com/vcvvvc/github_trending</a>
    </footer>
</main>

<script>
    const groups = {{.GroupsJSON}};
    const languageBar = document.getElementById("language-bar");
    const repoCards = document.getElementById("repo-cards");
    let active = 0;

    function renderLanguages() {
        languageBar.innerHTML = groups.map((group, index) => {
            const activeClass = index === active ? "active" : "";
            return `<button class="language-btn ${activeClass}" data-index="${index}">${group.GroupName} (${group.Repos.length})</button>`;
        }).join("");

        languageBar.querySelectorAll(".language-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                active = Number(btn.dataset.index);
                renderLanguages();
                renderRepos();
            });
        });
    }

    function renderRepos() {
        const repos = groups[active]?.Repos || [];
        if (!repos.length) {
            repoCards.innerHTML = `<div class="empty">该分组暂无仓库。</div>`;
            return;
        }

        repoCards.innerHTML = repos.map((repo, idx) => {
            const desc = repo.Description || "暂无描述";
            const lang = repo.Language || groups[active].GroupName;
            return `
                <a class="repo-card" href="${repo.URL}" target="_blank" rel="noopener" style="animation-delay:${idx * 0.03}s">
                    <div class="repo-head">
                        <h3 class="repo-name">${repo.Name}</h3>
                        <span class="repo-stars">★ ${Number(repo.Stars).toLocaleString()}</span>
                    </div>
                    <p class="repo-desc">${desc}</p>
                    <div class="repo-foot">Language: ${lang}</div>
                </a>
            `;
        }).join("");
    }

    renderLanguages();
    renderRepos();
</script>
</body>
</html>
